{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "message_type",
    "run_id",
    "task_id",
    "attempt",
    "project_root",
    "owner_department",
    "assigned_department",
    "delegation_mode",
    "delegation_id",
    "target_worker_skill",
    "source_dispatch",
    "source_report",
    "findings",
    "allowed_write_paths",
    "acceptance_criteria",
    "handoff_to"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0"
    },
    "message_type": {
      "const": "repair_request"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,63}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,63}$"
    },
    "attempt": {
      "type": "integer",
      "minimum": 2
    },
    "project_root": {
      "type": "string",
      "minLength": 1
    },
    "owner_department": {
      "type": "string",
      "enum": [
        "software",
        "writing"
      ]
    },
    "assigned_department": {
      "type": "string",
      "enum": [
        "software",
        "writing"
      ]
    },
    "delegation_mode": {
      "enum": [
        "owner-work",
        "guest-support"
      ]
    },
    "delegation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "target_worker_skill": {
      "enum": [
        "software-coding",
        "writing-writer"
      ]
    },
    "source_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "status",
        "snapshot_digest",
        "worker_skill"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "status": {
          "const": "FAIL"
        },
        "snapshot_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "worker_skill": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "severity",
          "rule_key",
          "rule_id",
          "location",
          "evidence",
          "impact",
          "required_action"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,63}$"
          },
          "severity": {
            "enum": [
              "BLOCKING",
              "NON_BLOCKING"
            ]
          },
          "rule_key": {
            "type": "string",
            "minLength": 1
          },
          "rule_id": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "line",
              "anchor"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "line": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "anchor": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "impact": {
            "type": "string",
            "minLength": 1
          },
          "required_action": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 1
    },
    "allowed_write_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "handoff_to": {
      "const": "owner-manager"
    },
    "source_dispatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI Company  Repair Request",
  "description": "Blocking findings are transferred without manager paraphrase; original report sha256 is pinned."
}
