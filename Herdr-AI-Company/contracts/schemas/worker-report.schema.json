{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "message_type",
    "run_id",
    "task_id",
    "attempt",
    "owner_department",
    "assigned_department",
    "delegation_mode",
    "delegation_id",
    "role",
    "worker_skill",
    "status",
    "scope",
    "method_references",
    "loaded_rules",
    "checks",
    "findings",
    "verification",
    "fixes",
    "limitations",
    "artifacts",
    "handoff_to"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0"
    },
    "message_type": {
      "const": "worker_report"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,63}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,63}$"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "owner_department": {
      "type": "string",
      "enum": [
        "software",
        "writing"
      ]
    },
    "assigned_department": {
      "type": "string",
      "enum": [
        "software",
        "writing"
      ]
    },
    "delegation_mode": {
      "enum": [
        "owner-work",
        "guest-support"
      ]
    },
    "delegation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "worker_skill": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "UNVERIFIED"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_root",
        "scope_paths",
        "snapshot_digest"
      ],
      "properties": {
        "project_root": {
          "type": "string",
          "minLength": 1
        },
        "scope_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "snapshot_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "method_references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      },
      "minItems": 0
    },
    "loaded_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "path",
          "sha256",
          "rule_ids"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "rule_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          }
        }
      },
      "minItems": 0
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "result",
          "evidence"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED",
              "NOT_RUN",
              "NOT_APPLICABLE"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "severity",
          "rule_key",
          "rule_id",
          "location",
          "evidence",
          "impact",
          "required_action"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,63}$"
          },
          "severity": {
            "enum": [
              "BLOCKING",
              "NON_BLOCKING"
            ]
          },
          "rule_key": {
            "type": "string",
            "minLength": 1
          },
          "rule_id": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "line",
              "anchor"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "line": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "anchor": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "impact": {
            "type": "string",
            "minLength": 1
          },
          "required_action": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 0
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "cwd",
          "result",
          "exit_code",
          "evidence_path"
        ],
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "cwd": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_RUN"
            ]
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "evidence_path": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "minItems": 0
    },
    "fixes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "resolution",
          "evidence"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,63}$"
          },
          "resolution": {
            "enum": [
              "FIXED",
              "UNRESOLVED"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 0
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "kind",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      },
      "minItems": 0
    },
    "handoff_to": {
      "const": "owner-manager"
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI Company  Worker Report",
  "description": "Immutable logical report, with evidence, original findings and frozen snapshot binding."
}
